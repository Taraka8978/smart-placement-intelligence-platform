{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Spring Boot Backend",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/run_backend.ps1"
      ],
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "platform"
      }
    },
    {
      "label": "Run React Frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run", "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "platform"
      }
    },
    {
      "label": "Run Full Platform (Backend + Frontend)",
      "dependsOn": [
        "Run Spring Boot Backend",
        "Run React Frontend"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
